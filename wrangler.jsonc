{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaseen-excalidraw",
  "main": "./worker/index.ts",
  "account_id": "06ed69083fae875c626d37f9c05405a3",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "draw.yaseenarshad.com",
      "custom_domain": true
    },
    {
      "pattern": "draw.yasinarshad.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./excalidraw-app/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "DIAGRAM_ASSETS",
      "bucket_name": "yaseen-excalidraw-assets"
    }
  ],
  "vars": {
    "CONVEX_SITE_URL": "https://moonlit-boar-611.convex.site",
    "DOCS_MODE": "off"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "name": "yaseen-excalidraw-dev",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "r2_buckets": [
        {
          "binding": "DIAGRAM_ASSETS",
          "bucket_name": "yaseen-excalidraw-assets-dev"
        }
      ],
      "vars": {
        "CONVEX_SITE_URL": "https://honorable-possum-626.convex.site",
        "DOCS_MODE": "on"
      }
    }
  }
}
