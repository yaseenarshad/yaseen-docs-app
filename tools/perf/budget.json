{
  "$comment": "Size and perf ceilings for npm run perf:budget / perf:budget:ci. Ratchet rule: shrinking a metric lowers its ceiling in the same PR; raising one needs Yasin's OK. Historical logs live in git log.",
  "baseline": "v0.9.27 @ 63aeeea",
  "sizeTolerance": 0.001,
  "ratchetedTo": "yaz-2131-speed @ f94390d",
  "size": {
    "appBytes": {
      "max": 342986768,
      "$comment": "Packaged macOS .app total bytes."
    },
    "frameworksBytes": {
      "max": 240920243,
      "$comment": "Electron Framework.framework bytes inside .app."
    },
    "asarBytes": {
      "max": 91699193,
      "$comment": "app.asar bytes inside .app."
    },
    "dmgBytes": {
      "max": 123685814,
      "$comment": "Compressed arm64 DMG bytes."
    },
    "chromiumLocaleCount": {
      "max": 8,
      "$comment": "Shipped Chromium locale.pak count (English only)."
    },
    "chromiumLocaleBytes": {
      "max": 1121390,
      "$comment": "Shipped Chromium locale.pak total bytes."
    },
    "lprojCount": {
      "max": 55,
      "min": 55,
      "$comment": "App-level .lproj markers kept so OS Open/Save panels match macOS language."
    },
    "asarNodeModulesFiles": {
      "max": 0,
      "$comment": "Unbundled node_modules files inside app.asar (must stay 0)."
    },
    "rendererEagerJsBytes": {
      "max": 3650291,
      "$comment": "Renderer entry JS static import closure bytes."
    },
    "rendererEagerCssBytes": {
      "max": 415927,
      "$comment": "Renderer entry CSS static closure bytes."
    },
    "rendererTotalBytes": {
      "max": 33741825,
      "$comment": "Renderer out/ total bytes (excluding excalidraw-assets)."
    },
    "rendererMapBytes": {
      "max": 0,
      "$comment": "Shipped .map bytes inside out/renderer (must stay 0)."
    },
    "mainBundleBytes": {
      "max": 1542407,
      "$comment": "Main process and CLI bundle bytes in out/main."
    },
    "shareViewerBytes": {
      "max": 11193478,
      "$comment": "Share-link viewer bundle bytes in share/dist/assets."
    }
  },
  "perfTolerance": 0.15,
  "perf": {
    "$comment": "Local harness timing and memory ceilings (npm run perf).",
    "drawio.drawioOpenMs": {
      "max": 760,
      "target": 650
    },
    "long-day.heapEndOverStartRatio": {
      "max": 1.1,
      "tolerance": 0
    },
    "long-day.heapSlopeMbPerCycle": {
      "max": 1,
      "tolerance": 0
    },
    "long-day.rendererFootprintEndMb": {
      "max": 300,
      "tolerance": 0
    },
    "long-day.workerHeapEndMb": {
      "max": 10,
      "tolerance": 0
    },
    "long-day-open.heapAfterWakeMb": {
      "max": 55,
      "tolerance": 0
    }
  }
}
