# The encyclopedia's KPI index. View 1 groups the whole set by funnel; view 2 is the
# canonical "all KPIs for this funnel" query written the standalone way, with link().
filters:
  and:
    - page_type == "kpi"
views:
  - type: table
    name: All KPIs
    order:
      - file.name
      - funnel_stages
      - kpi_category
      - unit
    sort:
      - property: file.name
        direction: ASC
    groupBy:
      property: funnel_stages
      direction: ASC
  - type: table
    name: Sales-Conversion
    filters:
      and:
        - funnel_stages.contains(link("Sales-Conversion"))
    order:
      - file.name
      - kpi_category
      - unit
    sort:
      - property: file.name
        direction: ASC
