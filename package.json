{
  "name": "yaseen-docs-app",
  "private": true,
  "version": "2.10.0",
  "description": "Yaseen Docs: local markdown editor as an Electron desktop app (React + Milkdown Crepe renderer, main-process file layer)",
  "workspaces": [
    "client",
    "desktop",
    "engine/packages/common",
    "engine/packages/math",
    "engine/packages/fractional-indexing",
    "engine/packages/element",
    "engine/packages/excalidraw"
  ],
  "scripts": {
    "dev": "npm run dev -w desktop",
    "build": "npm run build -w desktop",
    "engine:build": "node tools/buildEngine.mjs",
    "drawio:pack": "npm run engine:build && node tools/packDrawio.mjs",
    "desktop:build": "npm run build -w desktop && node tools/packDesktop.mjs --mac",
    "desktop:build:win": "npm run build -w desktop && node tools/packDesktop.mjs --win",
    "typecheck": "npm run engine:build && tsc -p client/tsconfig.json --noEmit && tsc -p shared/tsconfig.json --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "npm run engine:build && vitest run",
    "e2e": "npm run build -w desktop && playwright test --config desktop/e2e/playwright.config.ts",
    "e2e:only": "playwright test --config desktop/e2e/playwright.config.ts",
    "perf": "node tools/perf/run.mjs",
    "perf:budget": "node tools/perf/measureBudget.mjs",
    "perf:budget:ci": "node tools/perf/measureBudget.mjs --out-only",
    "test:watch": "npm run engine:build && vitest"
  },
  "devDependencies": {
    "@milkdown/components": "file:client/vendor/milkdown-components-7.22.1-yaz1410.tgz",
    "@milkdown/crepe": "file:client/vendor/milkdown-crepe-7.22.1-yaz3550.tgz",
    "@milkdown/plugin-tooltip": "file:client/vendor/milkdown-plugin-tooltip-7.22.1-yaz2238.tgz",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "pyright": "1.1.414",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@milkdown/components": "$@milkdown/components",
    "@milkdown/crepe": "$@milkdown/crepe",
    "@milkdown/plugin-tooltip": "$@milkdown/plugin-tooltip"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
