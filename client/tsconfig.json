{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The engine is a workspace link (YAZ-3574): read it where it is linked, so its types find the app's @types, not engine/node_modules.
    "preserveSymlinks": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // `@client/*` is the phone's name for this folder: a client test that loads phone code (YAZ-5618's
    // `cellTasksPhone.test.ts`) reads the phone modules that import `@client/...` (YAZ-5568's `pageMarked.ts`).
    "paths": { "@shared/*": ["../shared/*"], "@client/*": ["./src/*"] }
  },
  "include": ["src", "../shared", "vitest.config.ts"]
}
