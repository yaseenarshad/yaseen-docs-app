# The headers of Notecards on Cloudflare static assets (YAZ-5087). The Worker serves these files and nothing else:
# no script, no logs of addresses. `publish/headers.test.ts` checks this file against the calls the code makes.
#
# The page may call GitHub's API only (decision 8). Pictures: this site, blob:, data: and GitHub's avatar host
# (round 12, item 13). No inline script, no eval, no third-party script, font or analytics. No referrer ever: a friend
# link and the token never leak. The camera for this site only ("Scan a code").
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src https://api.github.com; img-src 'self' blob: data: https://avatars.githubusercontent.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build files: their name changes with their bytes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always asked again, so a new deploy is seen at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/friend
  Cache-Control: no-cache
/friend.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/version.txt
  Cache-Control: no-cache

# The service worker: its own policy. It fetches this site's files (the shell) and nothing else.
/sw.js
  Cache-Control: no-cache
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; connect-src 'self'
